#!/bin/bash

usage=\
"Usage: $(basename "$0") [OPTION]... [IMAGE_NAME]\n
Build an image for the container\n
\n
where:\n
    -h,     --help               show this help text\n
    -s,     --skip-deps          skip unpacking deps\n
    -a,     --android            build an android image\n
    -i,     --image              the name or URL of the base image to use\n
\n
If no IMAGE_NAME is given, it is deduced from the\n 
current directory name    
"

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source ${DIR}/find_default_container_file.inc

source $DIR/base-image.conf

if [[ -z "${BASE_APPIMAGE_IMAGE}" ]]; then
    echo "ERROR: base-image.conf doesn't have a name of appimage docker image"
    exit 1
fi

if [[ -z "${BASE_ANDROID_IMAGE}" ]]; then
    echo "ERROR: base-image.conf doesn't have a name of android docker image"
    exit 1
fi

DEPS_EXTRA_ARGS="--platform=linux/arm64 --progress=plain --memory=6g"
BASE_IMAGE="${BASE_APPIMAGE_IMAGE}"

# Call getopt to validate the provided input. 
options=$(getopt -o ashi: --long skip-deps,help,android,image: -- "$@")
[ $? -eq 0 ] || { 
    echo "Incorrect options provided"
    exit 1
}
eval set -- "$options"
while true; do
    case "$1" in
    -s | --skip-deps)
        DEPS_EXTRA_ARGS="--target=base_image"
        ;;
    -a | --android)
        BASE_IMAGE="${BASE_ANDROID_IMAGE}"
        ;;
    -i | --image)
        shift;
        BASE_IMAGE=$1
        ;;
    -h | --help)
        echo -e $usage >&2
        exit 1
        ;;
    --)
        shift
        break
        ;;
    esac
    shift
done

IMAGE_NAME=${@:$OPTIND:1}

echo "## Building image with base image: ${BASE_IMAGE}"
if [[ -z ${IMAGE_NAME} ]]; then
    IMAGE_NAME=$(basename $(realpath $DIR/..))
    echo Auto-select image name: ${IMAGE_NAME}
fi

# --- Get Host UIDs/GIDs ---
# This ensures the container user matches your host user for file permissions
HOST_UID=$(id -u)
HOST_GID=$(id -g)
# Provide a default for the render group if it doesn't exist on the host
RENDER_GID=$(getent group render | cut -d: -f3 || echo 110)

echo "## Using UID=${HOST_UID}, GID=${HOST_GID}, RENDER_GID=${RENDER_GID}"

# --- Build the Image ---
# This command has been corrected and simplified
docker buildx build \
    --progress=plain \
    --load \
    -t "${IMAGE_NAME}" \
    --build-arg "BASE_IMAGE=${BASE_IMAGE}" \
    --build-arg "APPIMAGE_UID=${HOST_UID}" \
    --build-arg "APPIMAGE_GID=${HOST_GID}" \
    --build-arg "RENDER_GID=${RENDER_GID}" \
    .

echo "## Build complete! Image '${IMAGE_NAME}' is ready."