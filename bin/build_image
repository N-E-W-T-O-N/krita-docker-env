#!/bin/bash

usage=\
"Usage: $(basename "$0") [OPTION]... [IMAGE_NAME]\n
Build an image for the container\n
\n
where:\n
    -h,      --help              show this help text\n
    -s,     --skip-deps          skip unpacking deps\n
    -a,     --android            build an android image\n
\n
If no IMAGE_NAME is given, it is deduced from the\n 
current directory name    
"

DEPS_EXTRA_ARGS=
BASE_IMAGE="invent-registry.kde.org/sysadmin/ci-images/krita-appimage-2204"

# Call getopt to validate the provided input. 
options=$(getopt -o ashi: --long skip-deps,help,android,image: -- "$@")
[ $? -eq 0 ] || { 
    echo "Incorrect options provided"
    exit 1
}
eval set -- "$options"
while true; do
    case "$1" in
    -s | --skip-deps)
        DEPS_EXTRA_ARGS="--target=base_image"
        ;;
    -a | --android)
        BASE_IMAGE="invent-registry.kde.org/sysadmin/ci-images/krita-android-builder-sdk34-2204"
        ;;
    -i | --image)
        shift;
        BASE_IMAGE=$1
        ;;
    -h | --help)
        echo -e $usage >&2
        exit 1
        ;;
    --)
        shift
        break
        ;;
    esac
    shift
done

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source ${DIR}/find_default_container_file.inc

IMAGE_NAME=${@:$OPTIND:1}

if [[ -z ${IMAGE_NAME} ]]; then
    IMAGE_NAME=$(basename $(realpath $DIR/..))
    echo Auto-select image name: ${IMAGE_NAME}
fi

${DOCKER_BINARY} build -t $IMAGE_NAME . ${DEPS_EXTRA_ARGS} \
    --build-arg BASE_IMAGE=$BASE_IMAGE \
    --build-arg APPIMAGE_UID=$(id -u) \
    --build-arg APPIMAGE_GID=$(id -g) \
    --build-arg RENDER_GID=$(getent group render | cut -d: -f3)
